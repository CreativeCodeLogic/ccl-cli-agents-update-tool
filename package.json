{
  "name": "ccl-caut",
  "version": "1.0.0-rc.2",
  "description": "CLI Agents Update Tool — check and update AI/dev CLIs from one terminal UI",
  "keywords": [
    "cli",
    "ai",
    "agents",
    "update",
    "claude",
    "codex",
    "gemini",
    "kimi",
    "gcloud",
    "firebase"
  ],
  "homepage": "https://github.com/CreativeCodeLogic/ccl-cli-agents-update-tool#readme",
  "bugs": {
    "url": "https://github.com/CreativeCodeLogic/ccl-cli-agents-update-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CreativeCodeLogic/ccl-cli-agents-update-tool.git"
  },
  "license": "MIT",
  "author": "Creative Code Logic",
  "type": "module",
  "bin": {
    "ccl-caut": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "cross-spawn": "^7.0.6",
    "figlet": "^1.12.0",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
