{
  "name": "ccl-caut",
  "version": "1.0.1",
  "description": "CLI Agents Update Tool — check and update AI/dev CLIs from one terminal UI",
  "keywords": [
    "cli",
    "ai",
    "agents",
    "update",
    "claude",
    "codex",
    "gemini",
    "kimi",
    "gcloud",
    "firebase"
  ],
  "homepage": "https://creativecodelogic.com",
  "license": "MIT",
  "author": "Creative Code Logic <admin@creativecodelogic.com> (https://creativecodelogic.com)",
  "type": "module",
  "bin": {
    "ccl-caut": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/demo.gif",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/pack-readme.mjs restore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepack": "node scripts/pack-readme.mjs swap",
    "postpack": "node scripts/pack-readme.mjs restore",
    "readme:npm": "node scripts/npm-readme.mjs"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "cross-spawn": "^7.0.6",
    "figlet": "^1.12.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
